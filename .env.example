# ---------- Google Maps Platform ----------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูกเก็บเข้า git)
#
# ถ้าไม่ตั้งค่าอะไรเลย แอปจะใช้ชุดฟรีเดิม (OpenStreetMap + Nominatim + Photon + OSRM)
# ได้ตามปกติทุกอย่าง การตั้งค่าเหล่านี้เป็นการ "เปลี่ยนไปใช้ Google" ไม่ใช่เงื่อนไขให้แอปทำงาน

# คีย์สำหรับ Maps JavaScript API เท่านั้น — ตัวนี้ออกไปอยู่ในเบราว์เซอร์โดยตั้งใจ
# ต้องจำกัดใน Cloud Console: เว็บใช้ HTTP referrer, แอป Android ใช้ชื่อแพ็กเกจ + ลายเซ็น SHA-1
# และเปิดสิทธิ์ให้คีย์นี้เฉพาะ Maps JavaScript API อย่างเดียว
VITE_GOOGLE_MAPS_BROWSER_KEY=

# URL ของ proxy ที่ถือคีย์ฝั่งเซิร์ฟเวอร์
# เว็บบน Vercel ปล่อยว่างได้ เพราะ /api อยู่โดเมนเดียวกัน
# แอป Android ต้องใส่ URL เต็ม เช่น https://taatip-gps.vercel.app
# ไม่งั้นคำขอจะวิ่งไปหา https://localhost ซึ่งไม่มีอะไรอยู่
VITE_API_BASE_URL=

# ---------- ตั้งค่าฝั่งเซิร์ฟเวอร์ (ใส่ใน Vercel เท่านั้น ห้ามขึ้นต้นด้วย VITE_) ----------
# คีย์คนละตัวกับด้านบน เปิดสิทธิ์ Places API (New) + Geocoding API + Routes API
# ตัวนี้ต้องไม่เคยออกไปถึงเบราว์เซอร์ จึงจำกัดด้วย referrer ไม่ได้ ให้จำกัดด้วย IP หรือไม่จำกัด
# GOOGLE_MAPS_SERVER_KEY=

# โทเค็นร่วมแบบไม่บังคับ กันคนที่บังเอิญเจอ URL ของ proxy มายิงจนบิลบาน
# ถ้าตั้ง ต้องตั้งให้ตรงกันทั้งฝั่งเซิร์ฟเวอร์และ VITE_API_TOKEN ฝั่งแอป
# API_TOKEN=
